# CiudadanoRD API — rutas limpias para hosting compartido
# /ciudadanoRD/combustibles → api.php?r=combustibles
DirectoryIndex api.php
RewriteEngine On
RewriteBase /ciudadanoRD/

# No reescribir archivos reales
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ api.php?r=$1 [QSA,L]

# Proteger la carpeta de caché
<FilesMatch "\.json$">
    Require all denied
</FilesMatch>
